# Copy this file to .env (git-ignored) and fill in your values.
# Do not put comments after a value; the loader reads the whole line.

# demo or prod. Keys are not shared between environments.
KALSHI_ENV=prod

# The Key ID Kalshi shows when you create an API key.
KALSHI_API_KEY_ID=

# Optional. Defaults to kalshi_private_key.pem next to this file.
KALSHI_PRIVATE_KEY_PATH=
